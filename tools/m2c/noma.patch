+# ---------------------------------------------------------------------------------------
+# noma (Wii no Ma 3DS decomp) extensions: paired singles, carry, special registers
+
+NOMA_PS_ARITH: Dict[str, int] = {
+    "ps_add": 2, "ps_sub": 2, "ps_mul": 2, "ps_div": 2, "ps_madd": 3, "ps_msub": 3,
+    "ps_nmadd": 3, "ps_nmsub": 3, "ps_madds0": 3, "ps_madds1": 3, "ps_muls0": 2,
+    "ps_muls1": 2, "ps_sum0": 3, "ps_sum1": 3, "ps_merge00": 2, "ps_merge01": 2,
+    "ps_merge10": 2, "ps_merge11": 2, "ps_mr": 1, "ps_neg": 1, "ps_abs": 1, "ps_nabs": 1,
+    "ps_res": 1, "ps_rsqrte": 1, "ps_sel": 3,
+}
+
+# Gekko also writes single-precision results to ps1 (lfs: see the load branches). The IR
+# patterns ignore these extra outputs like the carry; the single-precision conversions they
+# produce write ps1 too.
+NOMA_PS1_FROM_PS0: Set[str] = {
+    "fadds", "fsubs", "fmuls", "fdivs", "fres", "frsp", "fmadds", "fmsubs", "fnmadds",
+    "fnmsubs", "cvt.s.i.fictive", "cvt.s.u.fictive",
+}
+
+NOMA_SPRS: Dict[str, int] = {
+    "XER": 1, "LR": 8, "CTR": 9, "DSISR": 18, "DAR": 19, "DEC": 22, "SDR1": 25, "SRR0": 26,
+    "SRR1": 27, "SPRG0": 272, "SPRG1": 273, "SPRG2": 274, "SPRG3": 275, "EAR": 282,
+    "TBL": 284, "TBU": 285, "PVR": 287, "GQR0": 912, "GQR1": 913, "GQR2": 914, "GQR3": 915,
+    "GQR4": 916, "GQR5": 917, "GQR6": 918, "GQR7": 919, "HID2": 920, "WPAR": 921,
+    "DMA_U": 922, "DMA_L": 923, "UMMCR0": 936, "UPMC1": 937, "UPMC2": 938, "USIA": 939,
+    "UMMCR1": 940, "UPMC3": 941, "UPMC4": 942, "MMCR0": 952, "PMC1": 953, "PMC2": 954,
+    "SIA": 955, "MMCR1": 956, "PMC3": 957, "PMC4": 958, "HID0": 1008, "HID1": 1009,
+    "IABR": 1010, "HID4": 1011, "DABR": 1013, "L2CR": 1017, "ICTC": 1019, "THRM1": 1020,
