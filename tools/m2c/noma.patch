+def noma_var_shift(a: InstrArgs, kind: str) -> Optional[Expression]:
+    """noma: slw/srw/sraw use six bits of the shift register (32-63 shift everything out);
+    a C shift by 32 or more is undefined. None: the shift amount is a constant below 32."""
+    if not NOMA_GUEST:
+        return None
+    x, n = a.reg(1), a.reg(2)
+    un = early_unwrap(n)
+    if isinstance(un, Literal):
+        if (un.value & 63) < 32:
+            return None
+        if kind == "sraw":
+            return BinaryOp.sshift(x, ">>", Literal(31))
+        return Literal(0)
+    name = {"slw": "NOMA_SLW", "srw": "NOMA_SRW", "sraw": "NOMA_SRAW"}[kind]
+    return fn_op(name, [x, n], Type.s32() if kind == "sraw" else Type.u32())
+
+
+def noma_spr_number(arg: Argument) -> int:
+    if isinstance(arg, AsmLiteral):
+        return arg.value
+    name = getattr(arg, "symbol_name", None) or getattr(arg, "register_name", None) or str(arg)
+    key = name.upper()
+    if key not in NOMA_SPRS:
+        raise DecompFailure(f"unknown special-purpose register {name}")
+    return NOMA_SPRS[key]
+
+
+def noma_ps_pair(a: InstrArgs, i: int) -> "tuple[Expression, Expression]":
+    reg = a.reg_ref(i)
+    return a.reg(i), a.regs[Register(reg.register_name + "_1")]
+
+
+def noma_ps_eval(m: str, a: InstrArgs) -> "tuple[Expression, Expression]":
+    f = BinaryOp.f32
+    neg = lambda e: UnaryOp("-", e, type=Type.f32())
+    fabs = lambda e: fn_op("fabsf", [e], Type.f32())
+    if m in ("ps_add", "ps_sub", "ps_div"):
+        op = {"ps_add": "+", "ps_sub": "-", "ps_div": "/"}[m]
+        (a0, a1), (b0, b1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2)
+        return f(a0, op, b0), f(a1, op, b1)
+    if m == "ps_mul":
+        (a0, a1), (c0, c1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2)
+        return f(a0, "*", c0), f(a1, "*", c1)
+    if m in ("ps_madd", "ps_msub", "ps_nmadd", "ps_nmsub"):
+        (a0, a1), (c0, c1), (b0, b1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2), noma_ps_pair(a, 3)
+        op = "+" if m in ("ps_madd", "ps_nmadd") else "-"
+        r0, r1 = f(f(a0, "*", c0), op, b0), f(f(a1, "*", c1), op, b1)
+        if m.startswith("ps_nm"):
+            return neg(r0), neg(r1)
+        return r0, r1
+    if m in ("ps_madds0", "ps_madds1"):
+        (a0, a1), (c0, c1), (b0, b1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2), noma_ps_pair(a, 3)
+        c = c0 if m.endswith("0") else c1
+        return f(f(a0, "*", c), "+", b0), f(f(a1, "*", c), "+", b1)
+    if m in ("ps_muls0", "ps_muls1"):
+        (a0, a1), (c0, c1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2)
+        c = c0 if m.endswith("0") else c1
+        return f(a0, "*", c), f(a1, "*", c)
+    if m in ("ps_sum0", "ps_sum1"):
+        (a0, a1), (c0, c1), (b0, b1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2), noma_ps_pair(a, 3)
+        if m == "ps_sum0":
+            return f(a0, "+", b1), c1
+        return c0, f(a0, "+", b1)
+    if m.startswith("ps_merge"):
+        (a0, a1), (b0, b1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2)
+        return (a0 if m[8] == "0" else a1), (b0 if m[9] == "0" else b1)
+    if m in ("ps_mr", "ps_neg", "ps_abs", "ps_nabs", "ps_res", "ps_rsqrte"):
+        b0, b1 = noma_ps_pair(a, 1)
+        if m == "ps_mr":
+            return b0, b1
+        if m == "ps_neg":
+            return neg(b0), neg(b1)
+        if m == "ps_abs":
+            return fabs(b0), fabs(b1)
+        if m == "ps_nabs":
+            return neg(fabs(b0)), neg(fabs(b1))
+        fname = "__fres" if m == "ps_res" else "__frsqrte"
+        return fn_op(fname, [b0], Type.f32()), fn_op(fname, [b1], Type.f32())
+    if m == "ps_sel":
+        (a0, a1), (c0, c1), (b0, b1) = noma_ps_pair(a, 1), noma_ps_pair(a, 2), noma_ps_pair(a, 3)
+        zero = Literal(0, type=Type.f32())
+        return (TernaryOp(BinaryOp.fcmp(a0, ">=", zero), c0, b0, type=Type.f32()),
+                TernaryOp(BinaryOp.fcmp(a1, ">=", zero), c1, b1, type=Type.f32()))
+    raise DecompFailure(f"unhandled paired-single op {m}")
+
