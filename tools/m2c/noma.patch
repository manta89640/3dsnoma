+def noma_is_mmio_access(e: Expression) -> bool:
+    """A load from a literal hardware address (0xCC/0xCD: the GameCube and Hollywood
+    registers; 0xC8: the EFB). Reading these can have side effects (taking a mail, acking
+    an interrupt), so their order matters."""
+    e = early_unwrap(e)
+    while isinstance(e, Cast):
+        e = early_unwrap(e.expr)
+    if isinstance(e, (StructAccess, ArrayAccess)):
+        base = early_unwrap(e.struct_var if isinstance(e, StructAccess) else e.ptr)
+        while isinstance(base, Cast):
+            base = early_unwrap(base.expr)
+        if isinstance(base, Literal):
+            addr = (base.value + (e.offset if isinstance(e, StructAccess) else 0)) & 0xFFFFFFFF
+            return 0xC8000000 <= addr < 0xCE000000
+    return False
+
+
+def noma_force_mmio_loads(s: NodeState, a: InstrArgs) -> None:
+    """noma: give each hardware register read its own statement, in program order. Two reads
+    combined into one expression (`(*0xCC005006) | (*0xCC005004 << 16)`) could otherwise run
+    in either order -- and reading the DSP mailbox's low half takes the mail."""
+    for out in a.instruction_ref.instruction.outputs:
+        if not isinstance(out, Register):
+            continue
+        raw = s.regs.get_raw(out)
+        if isinstance(raw, EvalOnceExpr) and noma_is_mmio_access(raw.wrapped_expr):
+            raw.force()
+
+
+def noma_crbit(arg: Argument) -> Register:
+    if isinstance(arg, AsmLiteral):
+        n = arg.value
+        return Register(f"cr{n // 4}_{('lt', 'gt', 'eq', 'so')[n % 4]}")
+    raise DecompFailure(f"CR bit operand {arg} was not numbered by the asm rewrite")
+
+
+def noma_crop(m: str, x: "Condition", y: "Condition") -> Expression:
+    if m == "cror":
+        return BinaryOp(x, "||", y, type=Type.boolean())
+    if m == "crand":
+        return BinaryOp(x, "&&", y, type=Type.boolean())
+    if m == "crnor":
+        return BinaryOp(x, "||", y, type=Type.boolean()).negated()
+    if m == "crnand":
+        return BinaryOp(x, "&&", y, type=Type.boolean()).negated()
+    if m == "crandc":
+        return BinaryOp(x, "&&", y.negated(), type=Type.boolean())
+    if m == "crorc":
+        return BinaryOp(x, "||", y.negated(), type=Type.boolean())
+    if m == "crxor":
+        return BinaryOp(x, "!=", y, type=Type.boolean())
+    return BinaryOp(x, "==", y, type=Type.boolean())  # creqv
+
+
+def noma_carry_out(m: str, a: InstrArgs, result: Expression) -> Expression:
+    if m in ("addc", "addic"):
+        return BinaryOp.ucmp(result, "<", a.reg(1))
+    if m == "subfc":
+        return BinaryOp.ucmp(a.reg(2), ">=", a.reg(1))
+    if m == "subfic":
+        return BinaryOp.ucmp(Literal(a.imm_value(2) & 0xFFFFFFFF), ">=", a.reg(1))
+    if m == "srawi":
+        return fn_op("__srawi_ca", [a.reg(1), Literal(a.imm_value(2))], Type.u32())
+    if m == "sraw":
+        return fn_op("__sraw_ca", [a.reg(1), a.reg(2)], Type.u32())
+    if m in ("adde", "addze", "addme", "subfe", "subfze", "subfme"):
+        # the carry out of x + y + CA (subtractions add ~rA)
+        x = a.reg(1)
+        if m.startswith("subf"):
+            x = UnaryOp("~", x, type=Type.intish())
+        if m in ("adde", "subfe"):
+            y: Expression = a.reg(2)
+        else:
+            y = Literal(0 if m.endswith("ze") else 0xFFFFFFFF)
+        return fn_op("__adde_ca", [x, y, noma_carry_in(a)], Type.u32())
+    return fn_op("M2C_CARRY", [result], type=Type.s32())
+
+
+def noma_carry_in(a: InstrArgs) -> Expression:
+    return a.regs[Register("carry")]
+
+
+def noma_addze(a: InstrArgs) -> Expression:
+    carry = a.regs[Register("carry")]
+    if getattr(getattr(carry, "function", None), "c_symbol_name", None) == "__srawi_ca":
+        # srawi + addze: signed division by a power of two
+        return carry_add_to(a.reg(1))
+    return BinaryOp.intptr(a.reg(1), "+", carry)
 
 
