+def noma_psq(s: NodeState, a: InstrArgs, m: str, indexed: bool, update: bool,
+             is_store: bool, w_arg: Argument, i_arg: Argument) -> None:
+    def qnum(arg: Argument) -> int:
+        if isinstance(arg, AsmLiteral):
+            return arg.value
+        txt = str(getattr(arg, "symbol_name", None) or getattr(arg, "register_name", None) or arg)
+        mq = re.match(r"^\$?qr(\d)$", txt)
+        if mq:
+            return int(mq.group(1))
+        raise DecompFailure(f"{m}: bad quantization operand {arg}")
+
+    w, qi = qnum(w_arg), qnum(i_arg)
+    freg = a.reg_ref(0)
+    freg1 = Register(freg.register_name + "_1")
+    stack_info = a.stack_info
+    if indexed:
+        base_reg = a.reg_ref(1)
+        ea = handle_add_real(a.reg(1), a.reg(2), a)
+    else:
+        mem = a.memory_ref(1)
+        if not isinstance(mem, AddressMode):
+            raise DecompFailure(f"{m}: unsupported address {mem}")
+        base_reg = mem.base
+        ea = add_imm(base_reg, a.regs[base_reg], Literal(mem.offset), a)
+    fnum = int(freg.register_name[1:])
+    if indexed and stack_info.is_stack_reg(base_reg) and fnum >= 14 and not update:
+        # prologue/epilogue: li r0, off; psq_stx/psq_lx fN, r1, r0
+        return
+    if not indexed and stack_info.is_stack_reg(base_reg) and fnum >= 14 and not update:
+        # prologue save / epilogue restore of a callee-saved paired single
+        return
+    if qi == 0 and not indexed and not update:
+        m0 = AddressMode(offset=mem.offset, base=base_reg)
+        m1 = AddressMode(offset=mem.offset + 4, base=base_reg)
+        if is_store:
+            st = make_store_real(a.reg(0), None, m0, a.regs, stack_info, Type.f32())
+            if st is not None:
+                s.store_memory(st, freg)
+            if w == 0:
+                st = make_store_real(a.regs[freg1], None, m1, a.regs, stack_info, Type.f32())
+                if st is not None:
+                    s.store_memory(st, freg1)
+        else:
+            v0 = deref(m0, a.regs, stack_info, size=4)
+            v0.type.unify(Type.f32())
+            s.set_reg(freg, v0)
+            if w:
+                s.set_reg(freg1, Literal(0x3F800000, type=Type.f32()))
+            else:
+                v1 = deref(m1, a.regs, stack_info, size=4)
+                v1.type.unify(Type.f32())
+                s.set_reg(freg1, v1)
+    else:
+        if is_store:
+            s.write_statement(void_fn_op("__psq_st", [ea, a.reg(0), a.regs[freg1], Literal(w), Literal(qi)]))
+        else:
+            s.set_reg(freg, fn_op("__psq_ld0", [ea, Literal(qi)], Type.f32()))
+            s.set_reg(freg1, fn_op("__psq_ld1", [ea, Literal(w), Literal(qi)], Type.f32()))
+    if update:
+        s.set_reg(base_reg, ea)
+
